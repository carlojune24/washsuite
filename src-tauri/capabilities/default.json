{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "thermal-printer:default",
    "log:default",
    "dialog:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DOWNLOAD/**", "$DOCUMENT/**"]
    }
  ]
}
